# AI Engine (Google Gemini with multi-key rotation and fallback)
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEYS=key1,key2,key3

# (Optional) OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Sheets Configuration
# No service account needed — uses the same OAuth credentials as YouTube (credentials/client_secrets.json)
GOOGLE_SHEET_NAME=yt-automate
GOOGLE_SHEET_ID=1FF7RoUpHnTIDrMQe6ygH84pLqFf2nVh8neY8ceyDm5w
GOOGLE_SHEET_WORKSHEET=Sheet1
SHEETS_TOKEN_FILE=credentials/sheets_token.json

# YouTube Data API (Publishing)
YOUTUBE_CLIENT_SECRETS_FILE=credentials/client_secrets.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json

# Auto-Approve & Publishing Settings
AUTO_APPROVE=true
UPLOAD_TO_YOUTUBE=false   # false = Save shorts locally in data/output/ only (do not upload)

# Video & Shorts Settings
TARGET_CLIPS_COUNT=4    # Number of Shorts to create from each long video (e.g. 1, 2, 3, 4, 5)
MIN_CLIP_DURATION=20    # Minimum clip length in seconds
MAX_CLIP_DURATION=30    # Maximum clip length in seconds
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
VIDEO_FIT_MODE=blur     # blur = full video in center with blurred background (0% frame loss!), pad = black bars, crop = center crop
CLEANUP_SOURCE_VIDEO=false # false = keep downloaded source video in data/downloads/ to recreate clips without re-downloading

# Edge TTS Voice
TTS_VOICE=en-US-ChristopherNeural

# Database
DATABASE_PATH=data/pipeline.db

# (Optional) Manual Approval via Telegram or WhatsApp (only needed if AUTO_APPROVE=false)
# APPROVAL_PROVIDER=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
